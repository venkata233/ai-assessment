# Copy to .env (never commit it). Every value shown is a placeholder.
POSTGRES_PASSWORD=change-me
ANALYTICS_SECRET=change-me-to-a-long-random-string
# label:sha256-hex of the plaintext key, comma separated. Generate a hash with:
#   python -c "import hashlib,secrets;k=secrets.token_urlsafe(32);print(k, hashlib.sha256(k.encode()).hexdigest())"
API_KEYS=owner1:<64-hex-chars>
BASE_URL=http://localhost:8000
TRUSTED_PROXY_HOPS=0
DNS_CHECK_ENABLED=true
LOG_LEVEL=INFO
